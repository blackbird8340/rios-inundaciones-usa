---
// Widget embebible (iframe) por medidor: nivel, estado, distancia a flood stage y link de vuelta. noindex.
import { getGaugePage } from '../../lib/queries.ts';
import { STATUS_META, type FloodStatus } from '../../lib/flood.ts';
import { fmtTime, ft, ianaZone } from '../../lib/format.ts';
import { siteName, siteOrigin } from '../../lib/site.ts';
import '@fontsource-variable/public-sans';

const data = await getGaugePage(Astro.params.slug!);
if (!data) return new Response(null, { status: 404 });
const { gauge: g, lastObservation } = data;
Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
Astro.response.headers.set('Content-Security-Policy', 'frame-ancestors *');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
const stage: number | null = g.stage_ft ?? null;
const status = (stage != null ? g.status : 'no_data') as FloodStatus;
const tz = ianaZone(g.time_zone, g.state_code);
const href = `${siteOrigin(Astro.url.origin)}/gauge/${g.slug}/?utm_source=embed`;
const toFlood = stage != null && g.minor_ft != null ? g.minor_ft - stage : null;
const trend = g.trend === 'rising' ? '▲ rising' : g.trend === 'falling' ? '▼ falling' : g.trend === 'steady' ? '► steady' : '';
const obs = g.observed_at ?? lastObservation?.observed_at ?? null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={href.split('?')[0]} />
  <title>{g.name} river level</title>
  <style>
    :root { font-family: 'Public Sans Variable', system-ui, sans-serif; color: #10243a; }
    body { margin: 0; }
    a.w { display: grid; gap: 0.25rem; padding: 0.8rem 1rem; border: 1px solid #d5dee4; border-left: 8px solid var(--c); border-radius: 8px; background: #fff; color: inherit; text-decoration: none; min-height: 7rem; box-sizing: border-box; }
    .n { font-weight: 700; font-size: 0.95rem; line-height: 1.2; }
    .row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.3rem 0.7rem; }
    .lvl { font-weight: 800; font-size: 2rem; line-height: 1; }
    .pill { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.25rem 0.5rem; border-radius: 99px; background: var(--c); color: var(--t); }
    .s { font-size: 0.8rem; color: #4a5b6b; }
    .brand { font-size: 0.75rem; color: #2f6f8f; font-weight: 700; }
  </style>
</head>
<body>
  <a class="w" href={href} target="_blank" rel="noopener" style={`--c:${STATUS_META[status].color};--t:${['action', 'minor', 'normal'].includes(status) ? '#10243a' : '#fff'}`}>
    <span class="n">{g.name}, {g.state_code}</span>
    <span class="row"><span class="lvl">{ft(stage, 1)}</span><span class="pill">{STATUS_META[status].label}</span><span class="s">{trend}</span></span>
    <span class="s">{toFlood != null ? (toFlood > 0 ? `${toFlood.toFixed(1)} ft below flood stage (${ft(g.minor_ft)})` : `${(-toFlood).toFixed(1)} ft above flood stage (${ft(g.minor_ft)})`) : 'No NWS flood stage for this gauge'}{obs && ` · ${fmtTime(obs, tz)}`}</span>
    <span class="brand">Live from {siteName()} · what floods at each level →</span>
  </a>
</body>
</html>

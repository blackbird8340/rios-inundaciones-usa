  .faq details { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; margin-bottom: 0.5rem; }
  .faq summary { cursor: pointer; padding: 0.8rem 1rem; font-weight: 600; }
  .faq details p { padding: 0 1rem 0.9rem; color: var(--muted); max-width: 48rem; }
  .explain > p { max-width: 44rem; }
  .cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 0.6rem; margin: 1rem 0; }
  .cats div { padding: 0.8rem 1rem; background: var(--card); border-left: 6px solid var(--cat); border-radius: 6px; }
